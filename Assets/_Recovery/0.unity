--- !u!114 &1509291756
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1509291755}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2330b6f59de4c2349ad2089aeb64866f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UIPromptController
  pages:
  - pageName: Page 1
    pageText: Let us study how Mohr's salt is prepared in this experiment.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 973414851}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Page 2
    pageText: 'Select the salts that you will use to prepare the

      Mohr''s salt.'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 973414851}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    - panel: {fileID: 124742069}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Page 3
    pageText: 'You have identified the correct pieces of

      apparatus and chemicals.'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1728640075}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    - panel: {fileID: 1179620341}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Page 4
    pageText: Drag the bottle containing distilled water to add 5 mL to the 25 mL
      beaker.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1015581889}
      stayInUpcomingPages: 0
      enableOnce: 1
      hasBeenEnabledOnce: 0
    - panel: {fileID: 1784829915}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Page 5
    pageText: Drag the tripod stand near the burner.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1493289272}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    - panel: {fileID: 1050735828}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Page 6
    pageText: Drag a wire gauze on the tripod stand.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1874858213}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    - panel: {fileID: 956391717}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Page 7
    pageText: Drag the beaker containing water towards the tripod stand.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1156198928}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    - panel: {fileID: 1756636957}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Page 8
    pageText: "Tap on the burner to heat the water to about 40 \u2103."
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 368203170}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    - panel: {fileID: 1312350866}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Page 9
    pageText: 
    showDialogBox: 0
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 190123974865757325}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList:
    - targetObject: {fileID: 5272710864944466738}
      hideOnThisPage: 1
    - targetObject: {fileID: 437652369}
      hideOnThisPage: 1
    - targetObject: {fileID: 842075661}
      hideOnThisPage: 1
  - pageName: Page 10
    pageText: We shall weigh 3.5000 g of ferrous sulphate in a watch glass placed
      on the digital balance.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 190123974865757325}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    - panel: {fileID: 1227055203}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList:
    - targetObject: {fileID: 2587524843402487524}
      hideOnThisPage: 1
    - targetObject: {fileID: 1180553763960588362}
      hideOnThisPage: 1
    - targetObject: {fileID: 5272710864944466738}
      hideOnThisPage: 0
  - pageName: Page 11
    pageText: 'Drag the spatula, containing ferrous sulphate, to

      the watch
      glass on the balance till the mass of the

      salt is 3.5000 g.'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1163175143545957822}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList:
    - targetObject: {fileID: 7344681357462546247}
      hideOnThisPage: 1
    - targetObject: {fileID: 604701374701433389}
      hideOnThisPage: 1
    - targetObject: {fileID: 5272710864944466738}
      hideOnThisPage: 1
  - pageName: Page 12
    pageText: 
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 179478658}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    - panel: {fileID: 0}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Page 13
    pageText: 
    showDialogBox: 0
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 2089543755}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList:
    - targetObject: {fileID: 2587524843402487524}
      hideOnThisPage: 0
    - targetObject: {fileID: 1180553763960588362}
      hideOnThisPage: 0
  - pageName: Page 14
    pageText: We shall weigh 1.7000 g of ammonium sulphate in a watch glass placed
      on the digital balance.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 2089543755}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList:
    - targetObject: {fileID: 2587524843402487524}
      hideOnThisPage: 1
    - targetObject: {fileID: 1180553763960588362}
      hideOnThisPage: 1
  - pageName: Page 15
    pageText: 'Drag the spatula, containing ammonium sulphate,

      to the watch
      glass on the balance till the mass of the salt is 1.7000 g.'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 2089543755}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    - panel: {fileID: 0}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList:
    - targetObject: {fileID: 1180553763960588362}
      hideOnThisPage: 1
    - targetObject: {fileID: 2587524843402487524}
      hideOnThisPage: 1
  - pageName: Page 16
    pageText: 'Drag the spatula, containing ammonium sulphate,

      to the watch
      glass on the balance till the mass of the salt is 1.7000 g.'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1808176110}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Page 17
    pageText: 'Ferrous sulphate will hydrolyse in the

      presence of water and
      form ferrous hydroxide. To stop hydrolysis, a suitable reagent should be added.'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1808176110}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Page 18
    pageText: 
    showDialogBox: 0
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1838663108}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Page 19
    pageText: Drag the dropper placed in a reagent bottle of dilute sulphuric acid
      to add about 0.5 mL into the reaction mixture.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1454425735}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Page 20
    pageText: 'Drag the beaker containing warm water towards

      the beaker containing
      ferrous sulphate and

      ammonium sulphate crystals.'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 2138222639}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  dialogPanel: {fileID: 144539735}
  dialogImage: {fileID: 144539736}
  dialogText: {fileID: 144539737}
  commonDialogSprite: {fileID: 21300000, guid: fcdf00ffa8fd4314aa63955c6a9b5440, type: 3}

  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2330b6f59de4c2349ad2089aeb64866f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UIPromptController
  pages:
  - pageName: Slide1
    pageText: Let us study how Mohr's salt is prepared in this experiment.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 973414851}
      stayInUpcomingPages: 0
      enableOnce: 1
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Slide2
    pageText: 'Select the salts that you will use to prepare the

      Mohr''s salt.'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 973414851}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    - panel: {fileID: 124742069}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Slide3
    pageText: 'You have identified the correct pieces of

      apparatus and chemicals.'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1728640075}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    - panel: {fileID: 1179620341}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Slide4
    pageText: Drag the bottle containing distilled water to add 5 mL to the 25 mL
      beaker.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1015581889}
      stayInUpcomingPages: 0
      enableOnce: 1
      hasBeenEnabledOnce: 0
    - panel: {fileID: 1784829915}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Slide5
    pageText: Drag the tripod stand near the burner.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1493289272}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Slide6
    pageText: Drag a wire gauze on the tripod stand.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 0}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList: []
  - pageName: Slide7
    pageText: Drag the beaker containing water towards the tripod stand.
    showDialogBox: 0
    showAlternatePanels: 0
    alternatePanels: []
    objectVisibilityList: []
  - pageName: Slide8
    pageText: "Tap on the burner to heat the water to\nabout 40 \u2103."
    showDialogBox: 0
    showAlternatePanels: 0
    alternatePanels: []
    objectVisibilityList: []
  - pageName: Slide9
    pageText: 
    showDialogBox: 0
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1031444159}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList:
    - targetObject: {fileID: 1826746294}
      hideOnThisPage: 0
    - targetObject: {fileID: 3095970203685000450}
      hideOnThisPage: 0
    - targetObject: {fileID: 499543843}
      hideOnThisPage: 0
  - pageName: Slide10
    pageText: 'We shall weigh 3.5000 g of ferrous sulphate

      in a watch glass
      placed on the digital balance.'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 1031444159}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    - panel: {fileID: 1227055203}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
    objectVisibilityList:
    - targetObject: {fileID: 3095970203685000450}
      hideOnThisPage: 1
    - targetObject: {fileID: 499543843}
      hideOnThisPage: 1
    - targetObject: {fileID: 1826746294}
      hideOnThisPage: 1
  - pageName: Slide11
    pageText: 'Drag the spatula, containing ferrous sulphate, to

      the watch
      glass on the balance till the mass of the

      salt is 3.5000 g.'
    showDialogBox: 0
    showAlternatePanels: 0
    alternatePanels:
    - panel: {fileID: 1031444159}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
